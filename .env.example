NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database: Supabase Postgres (Project Settings → Database → Connection string).
# App runtime uses the pooled Supavisor connection (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations use the direct / session connection (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional offline fallback (pnpm db:up): set both URLs to postgresql://fish:fish@localhost:5432/fishparadise

# Signs sessions and OTP hashes. Required in production: openssl rand -base64 32
AUTH_SECRET=change-me-with-openssl-rand-base64-32

# This phone (E.164) becomes ADMIN on first login and in the seed.
ADMIN_PHONE=+910000000000

# OTP: console (dev, prints the code in the terminal) | msg91 (needs a DLT-approved template)
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
# MSG91 flow id for transactional SMS notifications (NOTIFY_PROVIDER=sms)
MSG91_SMS_FLOW_ID=

# Payments: fake (local, no keys – test payment page) | razorpay (test or live keys)
PAYMENT_PROVIDER=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Images (admin uploads, signed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications: console | whatsapp | sms
NOTIFY_PROVIDER=console
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
# Owner alerts for new orders (defaults to ShopSettings.whatsapp / phone)
OWNER_NOTIFY_PHONE=

# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"). Required in production.
CRON_SECRET=

# Error monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
