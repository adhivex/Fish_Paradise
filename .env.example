NEXT_PUBLIC_APP_URL=http://localhost:3000
# Database: Supabase Postgres (Project Settings → Database → Connection string).
# App runtime uses the pooled Supavisor connection (transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations use the direct / session connection (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional offline fallback (pnpm db:up): set both URLs to postgresql://fish:fish@localhost:5432/fishparadise
AUTH_SECRET=change-me-with-openssl-rand-base64-32

# Seed: this phone becomes ADMIN (E.164)
ADMIN_PHONE=+910000000000

# OTP: console (dev, prints to terminal) | msg91
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay (use test keys in dev)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Notifications: console | whatsapp
NOTIFY_PROVIDER=console
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Optional
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
SENTRY_DSN=
